DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=pass
DB_NAME=db
PASSWORD_PEPPER=pepper

# WooCommerce import. Keys come from the shop's
# WooCommerce -> Settings -> Advanced -> REST API (read permission is enough).
WOO_URL=https://shop.example.com
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx
# Set to "off" to disable the hourly sync and only run it from the admin panel.
WOO_SYNC_CRON=on
